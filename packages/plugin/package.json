{
  "name": "@whalemaid/plugin",
  "version": "0.1.0",
  "description": "WhaleMaid 被控插件：自建 listener + 认证网关，让手机接管本机 DSH（SPEC: docs/protocol.md）",
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "license": "AGPL-3.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=lib/index.js --external:@deepseek-ai/* --external:node:* && rm -rf lib/mobile-dist && cp -R ../mobile/dist lib/mobile-dist"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6",
    "@whalemaid/contract": "workspace:*",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
