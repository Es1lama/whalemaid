{
  "name": "@whalemaid/control",
  "version": "0.1.0",
  "description": "WhaleMaid 控制端插件：让任意 DSH agent 控制另一台主机的 whalemaid 网关（PC↔PC 远程控制）",
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "license": "AGPL-3.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=lib/index.js --external:@deepseek-ai/* --external:node:*"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@whalemaid/contract": "workspace:*",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
