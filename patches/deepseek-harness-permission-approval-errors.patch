+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { makeTranslate } from '@deepseek-ai/dsh-client-test-runtime'
+import { zh as commonZh } from '@deepseek-ai/dsh-client-locale/src/locales/zh.ts'
+import { ApprovalFlow } from '../src/client/skeleton/ApprovalPanel.tsx'
+import { PendingApproval } from '../src/client/contract/slots.ts'
+import { zh } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+const t = makeTranslate(zh, commonZh)
+
+function pending(answer: (outcome: 'allowed-once' | 'rejected') => Promise<void>): PendingApproval {
+  return new PendingApproval({
+    key: 'approval-1',
+    sessionId: 'session-1' as never,
+    payload: {
+      approvalId: 'approval-1',
+      toolName: 'bash',
+      reason: '需要执行命令',
+    },
+    respond: async ({ value }) => {
+      await answer(value.outcome)
+      return { accepted: true }
+    },
+  } as never)
+}
+
+describe('ApprovalFlow', () => {
+  it('shows answer failure and re-arms the same approval action', async () => {
+    const answer = vi.fn()
+      .mockRejectedValueOnce(new Error('approval transport offline'))
+      .mockResolvedValueOnce(undefined)
+    render(<ApprovalFlow pending={pending(answer)} t={t} />)
+
+    const allow = screen.getByRole('button', { name: '允许一次' })
+    fireEvent.click(allow)
+    expect((allow as HTMLButtonElement).disabled).toBe(true)
+    await waitFor(() => { expect(screen.getByRole('alert').textContent).toContain('approval transport offline') })
+    expect((screen.getByRole('button', { name: '允许一次' }) as HTMLButtonElement).disabled).toBe(false)
+
+    fireEvent.click(screen.getByRole('button', { name: '允许一次' }))
+    await waitFor(() => { expect(answer).toHaveBeenCalledTimes(2) })
+    expect(screen.queryByRole('alert')).toBeNull()
+  })
+
+  it('keeps the rejection outcome single-flight while the receipt is pending', async () => {
+    let resolve!: () => void
+    const answer = vi.fn(() => new Promise<void>((settle) => { resolve = settle }))
+    render(<ApprovalFlow pending={pending(answer)} t={t} />)
+
+    const reject = screen.getByRole('button', { name: '拒绝' })
+    fireEvent.click(reject)
+    fireEvent.click(reject)
+    expect(answer).toHaveBeenCalledTimes(1)
+    act(resolve)
+    await waitFor(() => { expect((screen.getByRole('button', { name: '拒绝' }) as HTMLButtonElement).disabled).toBe(true) })
+  })
+})
